--!strict
-- Card database loader. Data lives in ReplicatedStorage.CardData, generated by
-- tools/export_carddata.py (one ModuleScript per set + an index). Sets are
-- required lazily the first time a card from them is asked for.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

export type Color = "Red" | "Blue" | "Yellow" | "Green" | "Purple"
export type CardType = "Character" | "Event" | "Field" | "Action Point"
export type TriggerType = "" | "Draw" | "Special" | "Final" | "Color" | "Raid" | "Get" | "Active"

export type EnergyIcon = {
	color: string, -- a Color
	count: number,
}

-- Unconditional keyword effects parsed from the JP effect text (see tools/export_carddata.py).
export type Keywords = {
	step: boolean?,
	calledStrike: boolean?, -- 狙い撃ち (NA: Snipe)
	doubleAttack: boolean?,
	doubleBlock: boolean?,
	impact: number?,
	impactPlus: number?,
	damage: number?,
	damagePlus: number?,
	nullifyImpact: boolean?,
}

export type RaidSpec = {
	kind: "name" | "trait",
	value: string, -- JP card name or JP trait
}

export type Card = {
	key: string,
	numberJp: string,
	nameEn: string,
	nameJp: string,
	series: string,
	setName: string,
	cardType: CardType,
	colors: { Color },
	rarity: string,
	needEnergy: number?,
	ap: number?,
	bp: number?,
	bpMark: string, -- "", "+", "-" or "±" as printed next to BP
	generatedEnergy: { EnergyIcon },
	energyMark: boolean, -- "+" printed next to energy: an effect may raise it
	traits: { string },
	keywords: Keywords,
	raid: RaidSpec?,
	deckLimit: number?, -- card text overrides the 4-copy limit
	effectJp: string,
	effectEn: string,
	triggerType: TriggerType,
	triggerJp: string,
	triggerEn: string,
	imageUrl: string,
}

export type SetInfo = {
	id: string,
	series: string,
	setNames: { string },
	count: number,
}

type Index = {
	version: number,
	cardCount: number,
	sets: { SetInfo },
	keyToSet: { [string]: string },
	warnings: { [string]: { string } },
}

local root = ReplicatedStorage:WaitForChild("CardData")
local setsFolder = root:WaitForChild("sets")
local index = require(root:WaitForChild("index") :: ModuleScript) :: Index

local loadedSets: { [string]: { [string]: Card } } = {}

local CardData = {}

function CardData.getIndex(): Index
	return index
end

function CardData.getSets(): { SetInfo }
	return index.sets
end

function CardData.getSet(setId: string): { [string]: Card }?
	local cached = loadedSets[setId]
	if cached then
		return cached
	end
	local module = setsFolder:FindFirstChild(setId)
	if not module or not module:IsA("ModuleScript") then
		return nil
	end
	local cards = require(module) :: { [string]: Card }
	loadedSets[setId] = cards
	return cards
end

function CardData.get(key: string): Card?
	local setId = index.keyToSet[key]
	if not setId then
		return nil
	end
	local cards = CardData.getSet(setId)
	return cards and cards[key]
end

return CardData
